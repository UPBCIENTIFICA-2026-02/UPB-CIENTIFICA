# Shared File Service (shared-file-svc). Copiar a .env y ajustar.
#
# Se despliega en la VM node-repository, junto a Storage (diagrama de despliegue).
# El diagrama no le asigna puerto; se usa 8085, el siguiente libre del plan.
PUERTO=8085

# BD propia del servicio: solo guarda las relaciones de compartición, nunca bytes.
# Se crea con despliegue/cluster-virtualbox/0-crear-bases.sql.
DATABASE_URL=postgresql://shared_svc:shared_dev_2026@localhost:5432/comparticiones

# Distributed Storage: donde se comprueba el elemento y se APLICA el permiso.
# En la VM es el mismo equipo: http://127.0.0.1:8084
URL_STORAGE=http://127.0.0.1:8084

# ---------------------------------------------------------------------------
# Autenticación (mismo patrón Strategy que Storage y node-media)
#   simulado -> acepta tokens mock-token-<uid>-... (solo desarrollo local)
#   soap     -> valida contra validarToken de node-soap
# AL DESPLEGAR HAY QUE PONER "soap".
# ---------------------------------------------------------------------------
MODO_AUTENTICACION=simulado
URL_AUTH_SOAP=https://192.168.1.195:8081/soap/user.php
NAMESPACE_AUTH=http://192.168.1.195/soap

# Cómo se comprueba que el usuario destinatario existe (contrato: SHR-003).
#   simulado -> acepta cualquier nombre de usuario con formato válido
#   soap     -> operación obtenerUsuario de node-soap
# Por defecto, el mismo valor que MODO_AUTENTICACION.
# MODO_DIRECTORIO=soap

# Plantilla del Home de cada usuario. Authentication todavía no publica el
# directorio home (obtenerPerfilUsuario no lo devuelve), así que se usa la
# convención del sistema: /srv/home/<uid>, la misma que usa node-sync.
PLANTILLA_HOME=/srv/home/{uid}
