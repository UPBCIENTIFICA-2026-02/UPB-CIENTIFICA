# Claves del entorno local (VirtualBox + PostgreSQL del PC). Copiar a .env y
# rellenar. El .env NO se versiona. Se carga con:  . .\cargar-env.ps1
#
# Bases de datos (0-crear-bases.sql). Deben coincidir con el DATABASE_URL del
# .env de cada servicio.
UPBC_BD_CLAVE_STORAGE=
UPBC_BD_CLAVE_MEDIA=
UPBC_BD_CLAVE_SHARED=

# Usuario y administrador de las VMs del clúster (1-crear-vm-base.ps1).
UPBC_CLAVE_VM=
