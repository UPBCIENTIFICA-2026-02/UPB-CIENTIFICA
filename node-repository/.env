PUERTO=8084

# Relativa al directorio del servicio, que es desde donde arranca `npm start`.
# Antes decía ./node-repository/almacen-pruebas, que solo funcionaba si se
# arrancaba desde la raíz del monorepo: con `npm start` acababa creando
# node-repository/node-repository/almacen-pruebas, al lado de la carpeta buena.
# RUTA_CUOTAS (abajo) ya usaba el criterio correcto; ahora coinciden las dos.
#
# En la VM esto apunta al montaje NFS:  RAIZ_ALMACENAMIENTO=/srv/home
RAIZ_ALMACENAMIENTO=./almacen-pruebas
# PostgreSQL en node-repository (BD propia del servicio, no la de node-media)
DATABASE_URL=postgresql://storage_svc:storage_dev_2026@localhost:5432/metadatos_storage
CUOTA_POR_DEFECTO=5368709120
RUTA_CUOTAS=./cuotas.conf

# ---------------------------------------------------------------------------
# Autenticación
#
#   simulado -> acepta tokens mock-token-<uid>-... (solo desarrollo local)
#   soap     -> valida contra la operación validarToken de node-soap
#
# AL DESPLEGAR HAY QUE PONER ESTO EN "soap". Se deja en "simulado" para que el
# servicio arranque en un portátil sin la VM de node-soap levantada.
# ---------------------------------------------------------------------------
MODO_AUTENTICACION=simulado

# Endpoint REAL del WSDL de node-soap (antes apuntaba a
# http://node-soap:8081/AuthenticationService, que no existe: ni esa ruta, ni
# ese nombre de servicio). El WSDL publica https://192.168.1.195:8081/soap/user.php
# y el namespace es http://192.168.1.195/soap, no urn:upbcientifica-auth.
URL_AUTH_SOAP=https://192.168.1.195:8081/soap/user.php
NAMESPACE_AUTH=http://192.168.1.195/soap
