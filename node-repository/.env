PUERTO=8084

# Raíz del almacenamiento. En la VM es el montaje NFS; en local, una carpeta de prueba.
RAIZ_ALMACENAMIENTO=/srv/home

# Índice de metadatos (SQLite). Ver README: no está en el diagrama, hay que agregarlo.
RUTA_BD=./datos/metadatos.db

# Cuota por defecto en bytes (5 GB). Se puede sobrescribir por usuario en cuotas.conf
CUOTA_POR_DEFECTO=5368709120
RUTA_CUOTAS=./cuotas.conf

# Validación de token: "simulado" | "soap"
MODO_AUTENTICACION=simulado
URL_AUTH_SOAP=http://node-soap:8081/AuthenticationService
NAMESPACE_AUTH=urn:upbcientifica-auth