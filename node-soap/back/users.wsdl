<?xml version="1.0" encoding="UTF-8"?>
<!--
    Contrato XML WSDL para las operaciones de usuarios y servicios.

    ==========================================================================
     >>> CAMBIO QUE AFECTA A LA VM node-soap <<<

     ANTES: este comentario estaba ANTES de la declaración <?xml ... ?>, lo que
            hacía que el documento no fuera XML bien formado (la declaración
            debe ser el primer carácter del archivo, sin nada delante). Con eso,
            `new SoapServer($wsdl)` fallaba y el servicio no atendía ninguna
            petición.
     AHORA: la declaración va primera y el comentario después. Hay que volver a
            copiar este archivo a /var/www/html/soap/users.wsdl.

     Se AÑADEN tres operaciones —iniciarSesion, validarToken y cerrarSesion—
     que son las que esperan node-repository, node-media, node-sync y node-web.
     Las cinco que ya existían quedan intactas, con los mismos nombres, los
     mismos parámetros y los mismos campos de respuesta.

     Se MANTIENE a propósito el targetNamespace http://192.168.1.195/soap, para
     no invalidar ningún cliente de prueba que ya exista contra este contrato.
     Conviene cambiarlo más adelante a un URN estable (urn:upbcientifica:auth:v1)
     porque atar el namespace a una IP rompe a todos los clientes si la VM
     cambia de dirección; eso sí es un cambio coordinado con los demás frentes.
    ==========================================================================
-->

<definitions
    name="UsersService"
    targetNamespace="http://192.168.1.195/soap"
    xmlns:tns="http://192.168.1.195/soap"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns="http://schemas.xmlsoap.org/wsdl/">

    <types>

        <xsd:schema
            targetNamespace="http://192.168.1.195/soap">

            <!-- autenticarUsuario -->

            <xsd:element name="autenticarUsuario">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="usuario" type="xsd:string"/>
                        <xsd:element name="password" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="autenticarUsuarioResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="success" type="xsd:boolean"/>
                        <xsd:element name="message" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>


            <!-- obtenerUsuario -->

            <xsd:element name="obtenerUsuario">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="usuario" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="obtenerUsuarioResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="success" type="xsd:boolean"/>
                        <xsd:element name="message" type="xsd:string"/>
                        <xsd:element name="usuario" type="xsd:string" minOccurs="0" nillable="true"/>
                        <xsd:element name="nombre" type="xsd:string" minOccurs="0" nillable="true"/>
                        <xsd:element name="apellido" type="xsd:string" minOccurs="0" nillable="true"/>
                        <xsd:element name="correo" type="xsd:string" minOccurs="0" nillable="true"/>
                        <!-- D3: ruta del Home del usuario (atributo homeDirectory de LDAP).
                             Opcional: si falta, los servicios usan /srv/home/<uid>. -->
                        <xsd:element name="homeDirectory" type="xsd:string" minOccurs="0" nillable="true"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>


            <!-- obtenerGruposUsuario -->

            <xsd:element name="obtenerGruposUsuario">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="usuario" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="obtenerGruposUsuarioResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="success" type="xsd:boolean"/>
                        <xsd:element name="message" type="xsd:string"/>

                        <xsd:element
                            name="grupos"
                            type="xsd:string"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>


            <!-- obtenerPerfilUsuario -->

            <xsd:element name="obtenerPerfilUsuario">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="usuario" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="obtenerPerfilUsuarioResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="success" type="xsd:boolean"/>
                        <xsd:element name="message" type="xsd:string"/>
                        <xsd:element name="usuario" type="xsd:string" minOccurs="0"/>
                        <xsd:element name="perfil" type="xsd:string" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <!-- validarAccesoServicio -->
            <xsd:element name="validarAccesoServicio">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="usuario" type="xsd:string"/>
                        <xsd:element name="servicio" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="validarAccesoServicioResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="success" type="xsd:boolean"/>
                        <xsd:element name="message" type="xsd:string"/>
                        <xsd:element name="perfil" type="xsd:string" minOccurs="0"/>
                        <xsd:element name="servicio" type="xsd:string" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>


            <!-- ============================================================
                 iniciarSesion — NUEVA

                 Primer factor (contraseña contra LDAP) y, si hay un OTP
                 pendiente para el usuario, también el segundo. Devuelve el
                 token de sesión firmado que consumen todos los servicios.

                 codigoMfa es opcional: solo se exige cuando generarTokenMFA
                 creó un código y aún no se ha usado.
                 ============================================================ -->

            <xsd:element name="iniciarSesion">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="usuario" type="xsd:string"/>
                        <xsd:element name="password" type="xsd:string"/>
                        <xsd:element name="origenCliente" type="xsd:string" minOccurs="0"/>
                        <xsd:element name="codigoMfa" type="xsd:string" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="iniciarSesionResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="success" type="xsd:boolean"/>
                        <xsd:element name="message" type="xsd:string"/>
                        <xsd:element name="token" type="xsd:string" minOccurs="0"/>
                        <!-- segundos de vigencia, no fecha absoluta -->
                        <xsd:element name="expiraEn" type="xsd:int" minOccurs="0"/>
                        <!-- uid de LDAP: es una CADENA ("jperez"), no un número -->
                        <xsd:element name="uid" type="xsd:string" minOccurs="0"/>
                        <xsd:element name="roles" type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
                        <xsd:element name="grupos" type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>


            <!-- ============================================================
                 validarToken — NUEVA

                 La operación más llamada del sistema: node-repository,
                 node-media y node-sync la invocan en cada petición. Devuelve
                 uid, roles y grupos en una sola llamada.

                 Los GRUPOS son imprescindibles: el modelo de permisos Unix de
                 node-repository evalúa con ellos el segmento "grupo".
                 ============================================================ -->

            <xsd:element name="validarToken">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="token" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="validarTokenResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="valido" type="xsd:boolean"/>
                        <xsd:element name="uid" type="xsd:string" minOccurs="0"/>
                        <xsd:element name="roles" type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
                        <xsd:element name="grupos" type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
                        <xsd:element name="expiraEn" type="xsd:int" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>


            <!-- cerrarSesion — NUEVA -->

            <xsd:element name="cerrarSesion">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="token" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="cerrarSesionResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="success" type="xsd:boolean"/>
                        <xsd:element name="message" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>


            <!-- ============================================================
                 login / logout — ALIAS PARA EL CLIENTE MÓVIL

                 La app Android se escribió contra el contrato de
                 TRASPASO §3.4, que difiere de iniciarSesion en dos cosas:
                   - el parámetro se llama `contrasena`, no `password`;
                   - `roles` y `mapaServiciosAutorizados` son UNA cadena
                     separada por comas, no elementos repetidos, porque la app
                     hace .split(",") sobre el primer elemento que encuentra.

                 Se declaran aparte en vez de cambiar iniciarSesion para no
                 romper a node-web, node-repository, node-media ni node-sync.
                 ============================================================ -->

            <xsd:element name="login">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="usuario" type="xsd:string"/>
                        <xsd:element name="contrasena" type="xsd:string"/>
                        <xsd:element name="origenCliente" type="xsd:string" minOccurs="0"/>
                        <xsd:element name="codigoMfa" type="xsd:string" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="loginResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="success" type="xsd:boolean"/>
                        <xsd:element name="message" type="xsd:string"/>
                        <xsd:element name="token" type="xsd:string" minOccurs="0"/>
                        <xsd:element name="expiraEn" type="xsd:int" minOccurs="0"/>
                        <xsd:element name="uid" type="xsd:string" minOccurs="0"/>
                        <!-- separados por comas, a diferencia de iniciarSesion -->
                        <xsd:element name="roles" type="xsd:string" minOccurs="0"/>
                        <xsd:element name="grupos" type="xsd:string" minOccurs="0"/>
                        <xsd:element name="mapaServiciosAutorizados" type="xsd:string" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="logout">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="token" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="logoutResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="success" type="xsd:boolean"/>
                        <xsd:element name="message" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

        </xsd:schema>

    </types>


    <!-- MENSAJES -->

    <message name="autenticarUsuarioRequest">
        <part name="parameters"
              element="tns:autenticarUsuario"/>
    </message>

    <message name="autenticarUsuarioResponse">
        <part name="parameters"
              element="tns:autenticarUsuarioResponse"/>
    </message>


    <message name="obtenerUsuarioRequest">
        <part name="parameters"
              element="tns:obtenerUsuario"/>
    </message>

    <message name="obtenerUsuarioResponse">
        <part name="parameters"
              element="tns:obtenerUsuarioResponse"/>
    </message>


    <message name="obtenerGruposUsuarioRequest">
        <part name="parameters"
              element="tns:obtenerGruposUsuario"/>
    </message>

    <message name="obtenerGruposUsuarioResponse">
        <part name="parameters"
              element="tns:obtenerGruposUsuarioResponse"/>
    </message>

    <message name="obtenerPerfilUsuarioRequest">
        <part name="parameters" element="tns:obtenerPerfilUsuario"/>
    </message>

    <message name="obtenerPerfilUsuarioResponse">
        <part name="parameters" element="tns:obtenerPerfilUsuarioResponse"/>
    </message>

    <message name="validarAccesoServicioRequest">
        <part name="parameters" element="tns:validarAccesoServicio"/>
    </message>

    <message name="validarAccesoServicioResponse">
        <part name="parameters" element="tns:validarAccesoServicioResponse"/>
    </message>

    <message name="iniciarSesionRequest">
        <part name="parameters" element="tns:iniciarSesion"/>
    </message>

    <message name="iniciarSesionResponse">
        <part name="parameters" element="tns:iniciarSesionResponse"/>
    </message>

    <message name="validarTokenRequest">
        <part name="parameters" element="tns:validarToken"/>
    </message>

    <message name="validarTokenResponse">
        <part name="parameters" element="tns:validarTokenResponse"/>
    </message>

    <message name="cerrarSesionRequest">
        <part name="parameters" element="tns:cerrarSesion"/>
    </message>

    <message name="cerrarSesionResponse">
        <part name="parameters" element="tns:cerrarSesionResponse"/>
    </message>

    <message name="loginRequest">
        <part name="parameters" element="tns:login"/>
    </message>

    <message name="loginResponse">
        <part name="parameters" element="tns:loginResponse"/>
    </message>

    <message name="logoutRequest">
        <part name="parameters" element="tns:logout"/>
    </message>

    <message name="logoutResponse">
        <part name="parameters" element="tns:logoutResponse"/>
    </message>


    <!-- PORT TYPE -->

    <portType name="UsersPortType">

        <operation name="autenticarUsuario">
            <input message="tns:autenticarUsuarioRequest"/>
            <output message="tns:autenticarUsuarioResponse"/>
        </operation>

        <operation name="obtenerUsuario">
            <input message="tns:obtenerUsuarioRequest"/>
            <output message="tns:obtenerUsuarioResponse"/>
        </operation>

        <operation name="obtenerGruposUsuario">
            <input message="tns:obtenerGruposUsuarioRequest"/>
            <output message="tns:obtenerGruposUsuarioResponse"/>
        </operation>

        <operation name="obtenerPerfilUsuario">
            <input message="tns:obtenerPerfilUsuarioRequest"/>
            <output message="tns:obtenerPerfilUsuarioResponse"/>
        </operation>

        <operation name="validarAccesoServicio">
            <input message="tns:validarAccesoServicioRequest"/>
            <output message="tns:validarAccesoServicioResponse"/>
        </operation>

        <operation name="iniciarSesion">
            <input message="tns:iniciarSesionRequest"/>
            <output message="tns:iniciarSesionResponse"/>
        </operation>

        <operation name="validarToken">
            <input message="tns:validarTokenRequest"/>
            <output message="tns:validarTokenResponse"/>
        </operation>

        <operation name="cerrarSesion">
            <input message="tns:cerrarSesionRequest"/>
            <output message="tns:cerrarSesionResponse"/>
        </operation>

        <operation name="login">
            <input message="tns:loginRequest"/>
            <output message="tns:loginResponse"/>
        </operation>

        <operation name="logout">
            <input message="tns:logoutRequest"/>
            <output message="tns:logoutResponse"/>
        </operation>

    </portType>


    <!-- BINDING -->

    <binding
        name="UsersBinding"
        type="tns:UsersPortType">

        <soap:binding
            style="document"
            transport="http://schemas.xmlsoap.org/soap/http"/>


        <operation name="autenticarUsuario">

            <soap:operation
                soapAction="http://192.168.1.195/soap/autenticarUsuario"/>

            <input>
                <soap:body use="literal"/>
            </input>

            <output>
                <soap:body use="literal"/>
            </output>

        </operation>


        <operation name="obtenerUsuario">

            <soap:operation
                soapAction="http://192.168.1.195/soap/obtenerUsuario"/>

            <input>
                <soap:body use="literal"/>
            </input>

            <output>
                <soap:body use="literal"/>
            </output>

        </operation>


        <operation name="obtenerGruposUsuario">

            <soap:operation
                soapAction="http://192.168.1.195/soap/obtenerGruposUsuario"/>

            <input>
                <soap:body use="literal"/>
            </input>

            <output>
                <soap:body use="literal"/>
            </output>

        </operation>

        <operation name="obtenerPerfilUsuario">

            <soap:operation soapAction="http://192.168.1.195/soap/obtenerPerfilUsuario"/>

            <input>
                <soap:body use="literal"/>
            </input>

            <output>
                <soap:body use="literal"/>
            </output>

        </operation>

        <operation name="validarAccesoServicio">
            <soap:operation soapAction="http://192.168.1.195/soap/validarAccesoServicio"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>

        <operation name="iniciarSesion">
            <soap:operation soapAction="http://192.168.1.195/soap/iniciarSesion"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>

        <operation name="validarToken">
            <soap:operation soapAction="http://192.168.1.195/soap/validarToken"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>

        <operation name="cerrarSesion">
            <soap:operation soapAction="http://192.168.1.195/soap/cerrarSesion"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>

        <operation name="login">
            <soap:operation soapAction="http://192.168.1.195/soap/login"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>

        <operation name="logout">
            <soap:operation soapAction="http://192.168.1.195/soap/logout"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>

    </binding>


    <!-- SERVICE -->

    <service name="UsersService">

        <documentation>
            Servicio SOAP de usuarios,
            autenticacion y grupos
            de UPB-CIENTIFICA
        </documentation>

        <port
            name="UsersPort"
            binding="tns:UsersBinding">

            <soap:address
                location="https://192.168.1.195:8081/soap/user.php"/>

        </port>

    </service>

</definitions>
