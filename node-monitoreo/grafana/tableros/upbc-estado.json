{
 "uid": "upbc-estado",
 "title": "UPB-CIENTÍFICA — Estado del sistema",
 "description": "Monitoreo integral: disponibilidad, recursos, clúster HPC, almacenamiento y tráfico.",
 "tags": [
  "upbc"
 ],
 "timezone": "browser",
 "refresh": "10s",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "editable": true,
 "graphTooltip": 1,
 "panels": [
  {
   "type": "row",
   "title": "Disponibilidad de los servicios",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Estado ahora",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-upbc"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 24,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus-upbc"
     },
     "expr": "max by (servicio) (probe_success)",
     "legendFormat": "{{servicio}}",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "Arriba",
         "color": "green"
        },
        "0": {
         "text": "Caído",
         "color": "red"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "orientation": "vertical"
   },
   "description": "Sondas de blackbox_exporter: HTTP a /health, TCP a RMI, gRPC y PostgreSQL."
  },
  {
   "type": "bargauge",
   "title": "Disponibilidad en el periodo elegido",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-upbc"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus-upbc"
     },
     "expr": "100 * avg by (servicio) (avg_over_time(probe_success[$__range]))",
     "legendFormat": "{{servicio}}",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 95
       },
       {
        "color": "green",
        "value": 99
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "min": 0,
     "max": 100,
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "orientation": "horizontal",
    "displayMode": "gradient"
   },
   "description": "Reporte histórico: porcentaje del tiempo que cada servicio respondió (cambia el rango arriba a la derecha)."
  },
  {
   "type": "table",
   "title": "Alertas activas",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-upbc"
   },
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus-upbc"
     },
     "expr": "ALERTS{alertstate=\"firing\"}",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto"
     },
     "noValue": "Sin alertas activas"
    },
    "overrides": []
   },
   "options": {
    "showHeader": true
   },
   "description": "Reglas de node-monitoreo/prometheus/reglas/alertas.yml que se están cumpliendo ahora.",
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "job": true,
       "alertstate": true,
       "entorno": true
      },
      "renameByName": {
       "alertname": "Alerta",
       "severidad": "Severidad",
       "servicio": "Servicio",
       "instance": "Origen"
      }
     }
    }
   ]
  },
