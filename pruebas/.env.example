# Pruebas contra las VPS (entornos "vps" y "vps-pasarela"). Copiar a .env y
# rellenar. El .env NO se versiona. Lo lee lib/config.js; lo que se exporte en
# la terminal tiene prioridad.

# Direcciones de las tres VPS del CCA.
UPBC_VPS_NODO1=
UPBC_VPS_NODO2=
UPBC_VPS_NODO3=

# Acceso SSH de solo lectura (suites 13 y 14).
UPBC_SSH_USUARIO_NODO1=
UPBC_SSH_USUARIO_NODO2=
UPBC_SSH_USUARIO_NODO3=
UPBC_SSH_LLAVE=~/.ssh/<llave>

# Claves de los usuarios de prueba en el directorio de las VPS (opcional: si
# faltan, validar-objetivo.ps1 las pide sin mostrarlas).
# UPBC_CLAVE_user1=
# UPBC_CLAVE_investigador=
# UPBC_CLAVE_estudiante=
