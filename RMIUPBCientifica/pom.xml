<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cluster</groupId>
    <artifactId>rmi-system</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>rmi-system</name>
    <description>Sistema distribuido de gestión de trabajos en clúster basado en Java RMI (proyecto académico)</description>

    <modules>
        <module>common</module>
        <module>gestor-cluster</module>
        <module>job-runner</module>
        <module>job-api</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <spring-boot.version>3.2.5</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>17</release>
                        <!--
                            Conserva los nombres de los parámetros en el
                            bytecode (javac -parameters).

                            Sin esto, Spring no puede resolver un
                            @PathVariable / @RequestParam / @RequestHeader que
                            no lleve el nombre escrito a mano: Spring Framework
                            6.1 eliminó el mecanismo que lo deducía de la tabla
                            de variables locales. El resultado era que TODOS los
                            endpoints con variable de ruta respondían 400:
                            GET /jobs/{id}, GET /jobs/{id}/estado y
                            DELETE /jobs/{id} estaban caídos, y las pruebas de
                            JobControllerTest fallaban ya antes de este cambio.

                            spring-boot-starter-parent lo activa por omisión,
                            pero este proyecto no hereda de él (su padre es el
                            pom de rmi-system), así que hay que ponerlo aquí.
                        -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
